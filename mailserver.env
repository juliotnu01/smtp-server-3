# ----------------------------------------------------------------------------------------------------------------------
# mailserver.env - Environment variables for docker-mailserver
#
# IMPORTANT: Replace placeholders like 'yourdomain.com' with your actual domain details.
# It is strongly recommended to change the default password 'strongpassword123' to a secure, unique password.
# ----------------------------------------------------------------------------------------------------------------------

# --- SSL Configuration ---
# For production, use 'letsencrypt'. You will need to configure DNS records for validation.
# For initial local testing or if Let's Encrypt setup is complex, you can use 'self-signed'.
# However, self-signed certificates will cause trust warnings in email clients.
SSL_TYPE=letsencrypt
# If using Let's Encrypt, specify your email for notifications (optional but recommended)
# LETSENCRYPT_EMAIL=admin@yourdomain.com

# --- Server Hostname ---
# This should be the fully qualified domain name (FQDN) of your mail server.
# Example: mail.yourdomain.com
OVERRIDE_HOSTNAME=mail.yourdomain.com

# --- Storage Configuration ---
# ONE_DIR=1 simplifies the mail storage structure by keeping all user mailboxes in a single directory.
ONE_DIR=1

# --- Feature Flags ---
# Disable features not immediately needed for a lightweight setup.
# You can enable these later if required.
ENABLE_POSTGREY=0
ENABLE_CLAMAV=0
ENABLE_SPAMASSASSIN=0
# For Postfix MyNetworks, see https://docker-mailserver.github.io/docker-mailserver/latest/config/advanced/override-postfix-config/#permit_mynetworks
# PERMIT_DOCKER=network allows other Docker containers on the same network to relay mail.
# Adjust as per your security requirements.
PERMIT_DOCKER=network

# --- Other Settings ---
# Set to 1 to disable SMTP AUTH checks for submissions received via port 587 and 465 from within the PERMIT_DOCKER network.
# TRUST_AUTH_NETWORKS=0

# Log level: 'warn', 'info', 'debug'
# DMS_DEBUG=0 (0 for warn, 1 for info, 2 for debug)
LOG_LEVEL=warn

# Set the mailbox format. Default is maildir. Alternative is sdbox or mdbox.
# MAILBOX_FORMAT=maildir

# --- Postmaster Address ---
# Address for postmaster, abuse, etc.
# POSTMASTER_ADDRESS=postmaster@yourdomain.com

# --- Timezone ---
# Set the timezone for the container, e.g., America/New_York
# TZ=

# --- DKIM Settings ---
# To enable DKIM signing by default for all messages.
# ENABLE_OPENDKIM=1
# To enable DKIM signing for specific domains, add them to /tmp/docker-mailserver/opendkim-domains.txt
# Or manage via setup script: setup config dkim domain <domain>
# Key size for DKIM, default is 2048
# DKIM_KEYSIZE=2048

# --- Fail2Ban ---
# ENABLE_FAIL2BAN=1 # Disabled by default for simplicity, enable for production.

# --- SRS (Sender Rewriting Scheme) ---
# ENABLE_SRS=0 # Disabled by default. Enable if you forward emails and want to avoid SPF issues.

# --- Update Checker ---
# Periodically checks for updates to docker-mailserver.
# ENABLE_UPDATE_CHECK=1
# Interval for update checks (e.g., 1d for daily, 1w for weekly).
# UPDATE_CHECK_INTERVAL=1d

# Note: For a full list of available environment variables, refer to the official docker-mailserver documentation:
# https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/
#
# Remember to secure this file and its contents.
# After changing this file, you need to restart the mailserver container:
# docker-compose restart mailserver
# (or docker restart <container_id> if not using docker-compose)
# ----------------------------------------------------------------------------------------------------------------------
